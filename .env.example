# Copie para .env e ajuste (o .env não vai para o git).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trinar
SESSION_SECRET=troque-por-um-texto-aleatorio-longo
ADMIN_EMAIL=dona@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Nome da Professora

# Informações exibidas no site
ATELIE_WHATSAPP=45999990000
ATELIE_ENDERECO=Rua Exemplo, 123 — Centro, Cidade-UF
ATELIE_HORARIO=Seg a Sex, 9h às 18h · Sáb, 9h às 12h
ATELIE_INSTAGRAM=trinarateliecriativo
# Link "Incorporar mapa" do Google Maps (https://www.google.com/maps/embed?pb=...)
ATELIE_MAPA_URL=

# Coloque false para não criar os cursos de exemplo no primeiro deploy
SEED_CURSOS_EXEMPLO=true

# ---------- WhatsApp (Evolution API) ----------
# URL e chave da sua Evolution API (veja evolution-heroku/README.md)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=trinar
# URL pública do site (usada no webhook que recebe as mensagens). Ex.: https://trinar-atelie.herokuapp.com
APP_URL=
# Número pessoal da dona, para receber aviso de novas inscrições (pode configurar pelo painel também)
ATELIE_WHATSAPP_DONA=
# false = não roda lembretes/cobranças automáticos dentro do servidor (use o Heroku Scheduler)
WHATSAPP_AGENDADOR=true
